mode = 2d
import game
window.width = 320
window.height = 240
window.vsync = false
window.fps = 120

every frame {
    renderer.clear("#101020")
    renderer.rect(10, 10, 40, 30, "#ff0000")
    renderer.circle(100, 50, 20, "#00ff00")
    renderer.line(10, 100, 80, 100, "#ffffff")
    renderer.outline(160, 10, 30, 30, "#0000ff")
    renderer.image("../../examples/assets/checker.png", 200, 10)
    renderer.text("Indium 49", 10, 130, 26, "#ddddff")
    if game.frames == 0 { print(window.backend) }
    if game.frames == 1 { renderer.save("render-output.png") }
} loop
